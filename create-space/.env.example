# --- Cloudinary (media uploads for CMS — set on backend API server) ---
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_UPLOAD_FOLDER=zentroverse

# --- Admin panel (must match src/lib/admin/auth.ts demo token) ---
ADMIN_PANEL_TOKEN=ZV-ADMIN-2026-DEMO

# --- Supabase (optional — Node API handles leads by default) ---
# Project ref from supabase/config.toml: yfdbkvcsaeskbdrhvulx
VITE_SUPABASE_URL=https://yfdbkvcsaeskbdrhvulx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=yfdbkvcsaeskbdrhvulx

# --- Backend API ---
# Dev (local backend): http://localhost:8787  |  Production: https://backend.zentrosure.com
# Leave empty to use Vite proxy in dev (npm run dev → localhost:8787)
VITE_API_BASE_URL=https://backend.zentrosure.com

# Run both frontend + backend: npm run dev:all
# Or separately: backend → cd ../Zentroverse-backend-final && npm run dev
#                 frontend → npm run dev  (port 8080)

# --- Lead notifications (server-side, optional) ---
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/...  (email, sheets, CRM)
# WHATSAPP_NOTIFY_URL=https://your-whatsapp-api-endpoint
# ADMIN_NOTIFY_EMAIL=digital@zentroverse.com

# --- Analytics & tracking (optional — set IDs to enable) ---
# VITE_GTM_ID=GTM-PJFWB6SF
# VITE_GA4_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=1668103460882753
# VITE_CLARITY_ID=your-clarity-id
# VITE_LINKEDIN_PARTNER_ID=your-linkedin-partner-id
# VITE_WHATSAPP_NUMBER=919973045587
# VITE_CONTACT_PHONE=+91 99730 45587
# Default client id is set in src/config/google.ts if unset.
# VITE_GOOGLE_CLIENT_ID=247765246302-ts0ji1kalu2shvbfr0hqh83rau7f70pf.apps.googleusercontent.com
